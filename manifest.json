{
  "manifest_version": 3,
  "name": "SwiftConvert",
  "version": "0.2.0",
  "description": "Seamlessly convert mismatched file uploads to the format a site expects.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SwiftConvert",
    "default_popup": "src/options/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:;"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": [
        "src/lib/mime.js",
        "src/lib/converters/image.js",
        "src/lib/converters/pdf-write.js",
        "src/lib/converters/stubs.js",
        "src/lib/converters/registry.js",
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/page-hook.js",
        "src/lib/mime.js",
        "src/lib/converters/registry.js",
        "src/lib/converters/image.js",
        "src/lib/converters/pdf-write.js",
        "src/lib/converters/stubs.js",
        "src/convert/host.html",
        "src/convert/host.js",
        "src/lib/converters/heic.js",
        "src/lib/converters/pdf.js",
        "src/lib/converters/docx.js",
        "src/lib/vendor/heic2any.min.js",
        "src/lib/vendor/mammoth.browser.min.js",
        "src/lib/vendor/pdf.min.mjs",
        "src/lib/vendor/pdf.worker.min.mjs",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/src/mark.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "swiftconvert@local.dev",
      "strict_min_version": "128.0"
    }
  }
}
